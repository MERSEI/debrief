# Куда складывать WAV-дорожки сессий
DEBRIEF_RECORDINGS_DIR=./recordings

# Папка Obsidian-хранилища для готовых протоколов. Пусто — не писать заметки.
DEBRIEF_VAULT_DIR=

# Модель Whisper: tiny | base | small | medium | large-v3
DEBRIEF_WHISPER_MODEL=large-v3
# auto | cuda | cpu
DEBRIEF_WHISPER_DEVICE=auto
# default | int8 | int8_float16 | float16 — int8 заметно быстрее на CPU
DEBRIEF_WHISPER_COMPUTE_TYPE=default
# Код языка (ru, en) или auto для автоопределения
DEBRIEF_LANGUAGE=ru

# Ключ Anthropic для разбора стенограммы
ANTHROPIC_API_KEY=

# Куда присылать готовый протокол. Оба поля пусты — не отправлять.
DEBRIEF_TELEGRAM_TOKEN=
DEBRIEF_TELEGRAM_CHAT_ID=

# Оставлять ли WAV после разбора
DEBRIEF_KEEP_AUDIO=true
